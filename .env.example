# =============================================================================
# Enterprise RAG Copilot — 环境变量模板
# =============================================================================
#   cp .env.example .env      （Windows PowerShell: Copy-Item .env.example .env）
#
# 只有 LLM_API_KEY（或 DEEPSEEK_API_KEY）是必填项，其余全部有可用默认值：
# 不配置 embedding key 时，向量检索使用**离线哈希向量**，功能完整、无需联网。
#
# 真实密钥不要提交到 Git（.env 已被 .gitignore 忽略）。
# =============================================================================

# --------------------------------------------------------------------- LLM ---
# 必填：任意 OpenAI 兼容的 chat completions 服务。
LLM_API_KEY=
# 兼容旧变量名；两者取其一即可（LLM_API_KEY 优先）。
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# --------------------------------------------------------------- Embedding ---
# hashing = 离线确定性哈希向量（默认，无需 key、无需联网）
# openai  = 任意 OpenAI 兼容 /embeddings 端点
# none    = 关闭向量分支，退化为纯 BM25 关键词检索
EMBEDDING_PROVIDER=hashing
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

# ------------------------------------------------------------------- 检索 ---
# keyword | vector | hybrid
RETRIEVER_MODE=hybrid
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
# rrf（默认，秩融合，无需跨分支分数标定）| weighted（分数归一化加权）
FUSION_STRATEGY=rrf
FUSION_ALPHA=0.5
RRF_K=60
# off | heuristic（默认，确定性词法重排）| llm（模型交叉打分，成本更高）
RERANK_PROVIDER=heuristic

# --------------------------------------------------------------- 向量存储 ---
# numpy（默认，进程内精确余弦检索）| pgvector（需要 DATABASE_URL 与 psycopg）
VECTOR_STORE=numpy
DATABASE_URL=

# ------------------------------------------------------------------- 切分 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ------------------------------------------------------------------ Agent ---
# auto（有 langgraph 就用 LangGraph）| langgraph | native
AGENT_ENGINE=auto
AGENT_MAX_STEPS=12
AGENT_ALLOW_GENERAL_FALLBACK=true
AGENT_REQUIRE_HUMAN_CHECK=false

# ----------------------------------------------------------------- Prompt ---
PROMPT_VERSION=v1

# ------------------------------------------------------------------- 路径 ---
# ⚠️ 本地开发请保持注释。留空或注释掉即使用仓库内置目录。
# 注意：不要写成 `KB_DIR=`（空值）——容器里 compose 的 `env_file` 会用空值覆盖
# 镜像的 ENV，应用会回退到镜像内默认路径并**以 0 文档启动**。
# Docker 部署时这三个路径由 docker-compose.yml 的 `environment` 显式钉住。
# KB_DIR=
# PROMPTS_DIR=
# DATA_DIR=

# --------------------------------------------------------------- 演示保护 ---
# 访问密码：留空 = 开放演示（任何人可直接进入，无需登录页）。
# 填写后前端出现访问密码登录页，后端以 HMAC 派生会话令牌校验。
# 二者都是受支持的模式，留空不是「配置缺失」。
DEMO_PASSWORD=
# true 时关闭全部写操作（上传 / 编辑 / 删除 / 重建索引 / 清空台账）。
DEMO_READ_ONLY=false

# ------------------------------------------------------------ AI 端点限流 ---
# 开放演示下 AI 端点会消耗真实 token 额度，用每客户端限流兜底。
# 只覆盖高成本端点：/api/chat、/api/rag/query、/api/agent/run、
# /api/solutions/{analyze,generate,export}。
# 浏览类端点（/health、overview、知识库浏览、/api/rag/retrieve）**不限流**。
# 默认 false：本地开发与测试永不被限流，只有公网演示才开启。
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------------------------- 上传限制 ---
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_SUFFIXES=.md,.txt,.pdf,.docx

# ----------------------------------------------------------------- 可观测 ---
ACTIVITY_ENABLED=true
# sqlite（默认）| jsonl
ACTIVITY_BACKEND=sqlite
ACTIVITY_MAX_RECORDS=2000

# ------------------------------------------------------------------- 评测 ---
EVAL_DATASET=

# ------------------------------------------------------------------- CORS ---
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- 其他 ---
APP_NAME=Enterprise RAG Copilot
APP_VERSION=3.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --------------------------------------------------------------- 前端变量 ---
# 会被编译进浏览器包，不要放任何密钥。
#
# 默认留空 = 同源模式：浏览器请求 `/api/...` 与 `/health`，
# 由 Next 反代到 API_PROXY_TARGET（见 apps/web/next.config.ts）。
# 本地开发同样适用，且与生产行为完全一致 —— 这样就不会出现
# 「本地能跑、部署后包里的地址是 localhost」这类问题。
NEXT_PUBLIC_API_BASE_URL=

# 备选：前后端不同源时才需要填绝对地址（一般仅特殊调试用）。
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
