# syntax=docker/dockerfile:1
#
# Backend image: FastAPI + retrieval + agent runtime.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.backend -t rag-copilot-backend .
#
# The build context is the repository root because the backend needs
# `knowledge_base/` and `prompts/` at runtime.

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Optional package mirror. Empty means "use the default upstream index", so the
# image stays portable; a deployment whose route to PyPI is slow or restricted
# points PIP_INDEX_URL at a regional mirror through .env.
#
# This matters: measured from a mainland Tencent Cloud host, pypi.org served
# 18 KB/s while the regional mirror served 4.4 MB/s. The backend requirements
# pull 74 distributions (numpy alone is 16.7 MB), so the difference is minutes
# versus hours.
ARG PIP_INDEX_URL=

WORKDIR /app

# Compiler toolchain, but ONLY where a pinned dependency has no prebuilt wheel.
#
# The architecture is read with `dpkg --print-architecture` rather than from the
# TARGETARCH build arg: inside the shell this is unambiguous, whereas an ARG
# whose value did not reach the shell made the guard evaluate the wrong way and
# installed the toolchain anyway.
#
# Every dependency in backend/requirements.txt ships a manylinux wheel for
# amd64, so on amd64 the toolchain is dead weight: it drags in ~200 MB and
# requires an apt index download that can stall the whole build.
ARG DEBIAN_MIRROR=
RUN ARCH="$(dpkg --print-architecture)"; \
    if [ "$ARCH" != "amd64" ]; then \
        if [ -n "$DEBIAN_MIRROR" ]; then \
            if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
                sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
            elif [ -f /etc/apt/sources.list ]; then \
                sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list; \
            fi; \
        fi; \
        apt-get update \
        && apt-get install -y --no-install-recommends build-essential \
        && rm -rf /var/lib/apt/lists/*; \
    else \
        echo "arch=$ARCH: prebuilt wheels only, skipping the compiler toolchain"; \
    fi

COPY backend/requirements.txt ./backend/requirements.txt
RUN INDEX="${PIP_INDEX_URL:-https://pypi.org/simple}"; \
    echo "pip index: $INDEX"; \
    pip install --no-cache-dir --index-url "$INDEX" -r backend/requirements.txt

# Non-root runtime user.
RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY --chown=appuser:appuser backend/ ./backend/
COPY --chown=appuser:appuser prompts/ ./prompts/
COPY --chown=appuser:appuser knowledge_base/ ./knowledge_base/

# Runtime state (index cache, activity ledger, eval dataset, exports).
RUN mkdir -p /app/backend/data && chown -R appuser:appuser /app/backend/data

USER appuser
WORKDIR /app/backend

ENV KB_DIR=/app/knowledge_base \
    PROMPTS_DIR=/app/prompts \
    DATA_DIR=/app/backend/data \
    ENVIRONMENT=production

EXPOSE 8000

# Health probe uses the interpreter already in the image. Depending on curl was
# the only reason apt had to run on amd64 at all.
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD ["python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).status == 200 else 1)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
