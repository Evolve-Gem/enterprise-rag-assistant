# syntax=docker/dockerfile:1
#
# Backend image: FastAPI + retrieval + agent runtime.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.backend -t rag-copilot-backend .
#
# The build context is the repository root because the backend needs
# `knowledge_base/` and `prompts/` at runtime.

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Build deps for wheels that have no prebuilt binary for linux/arm64.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt \
    && apt-get purge -y --auto-remove build-essential

# Non-root runtime user.
RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY --chown=appuser:appuser backend/ ./backend/
COPY --chown=appuser:appuser prompts/ ./prompts/
COPY --chown=appuser:appuser knowledge_base/ ./knowledge_base/

# Runtime state (index cache, activity ledger, eval dataset, exports).
RUN mkdir -p /app/backend/data && chown -R appuser:appuser /app/backend/data

USER appuser
WORKDIR /app/backend

ENV KB_DIR=/app/knowledge_base \
    PROMPTS_DIR=/app/prompts \
    DATA_DIR=/app/backend/data \
    ENVIRONMENT=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
