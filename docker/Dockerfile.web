# syntax=docker/dockerfile:1
#
# Frontend image: Next.js 15 served by `next start`.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.web -t rag-copilot-web .
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# NEXT_PUBLIC_API_BASE_URL must be passed as a build arg.
#
# The default is EMPTY on purpose, and must never be an absolute URL.
# Empty means "same origin": the browser calls /api and /health on the origin
# that served the page, and the Next server proxies them to API_PROXY_TARGET
# (a runtime setting, see next.config.ts). Defaulting to http://localhost:8000
# here would bake localhost into every production bundle.

FROM node:22-alpine AS deps
WORKDIR /app
# Optional npm mirror. Empty means "use the default registry", so the image
# stays portable; a deployment whose route to registry.npmjs.org is slow or
# restricted points NPM_REGISTRY at a regional mirror through .env.
#
# Measured from a mainland Tencent Cloud host: registry.npmjs.org served
# 146 KB/s while the regional mirror served 49 MB/s. `npm ci` fetches the whole
# dependency tree, so the difference is minutes versus far too long.
ARG NPM_REGISTRY=
COPY apps/web/package.json apps/web/package-lock.json* ./
# Rewrite the resolved registry in the lockfile, keeping the path separator.
#
# The trailing slash matters: the pattern swallows it, so the replacement must
# put it back. Without it, "https://registry.npmjs.org/zwitch/-/zwitch-2.0.4.tgz"
# becomes "https://registry.npmmirror.comzwitch/-/zwitch-2.0.4.tgz" and npm
# fails with ENOTFOUND on the host "registry.npmmirror.comzwitch". The value is
# normalised first so an operator may write the mirror with or without a
# trailing slash.
RUN if [ -n "$NPM_REGISTRY" ]; then \
      MIRROR="${NPM_REGISTRY%/}/"; \
      echo "npm registry override: $MIRROR"; \
      sed -i "s#https://registry.npmjs.org/#${MIRROR}#g" package-lock.json; \
    fi; \
    npm ci --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001

# Create the group first and put the user in it, so `--chown=nextjs:nodejs`
# below resolves and the non-root process can write `.next/cache` at runtime.
# Without the chown, root-owned build output makes image optimisation / ISR
# fail with EACCES even though the container starts fine.
RUN addgroup -g 1001 -S nodejs \
    && adduser -S nextjs -u 1001 -G nodejs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/next.config.ts ./next.config.ts

RUN mkdir -p /app/.next/cache && chown -R nextjs:nodejs /app/.next

USER nextjs
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3001/ >/dev/null 2>&1 || exit 1

# Deterministic entrypoint: no npx resolution, no chance of a network lookup.
CMD ["node", "node_modules/next/dist/bin/next", "start", "--port", "3001", "--hostname", "0.0.0.0"]
