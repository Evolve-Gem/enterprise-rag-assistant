# syntax=docker/dockerfile:1
#
# Frontend image: Next.js 15 served by `next start`.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.web -t rag-copilot-web .
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# NEXT_PUBLIC_API_BASE_URL must be passed as a build arg.
#
# The default is EMPTY on purpose, and must never be an absolute URL.
# Empty means "same origin": the browser calls /api and /health on the origin
# that served the page, and the Next server proxies them to API_PROXY_TARGET
# (a runtime setting, see next.config.ts). Defaulting to http://localhost:8000
# here would bake localhost into every production bundle.

FROM node:22-alpine AS deps
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001

# Create the group first and put the user in it, so `--chown=nextjs:nodejs`
# below resolves and the non-root process can write `.next/cache` at runtime.
# Without the chown, root-owned build output makes image optimisation / ISR
# fail with EACCES even though the container starts fine.
RUN addgroup -g 1001 -S nodejs \
    && adduser -S nextjs -u 1001 -G nodejs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/next.config.ts ./next.config.ts

RUN mkdir -p /app/.next/cache && chown -R nextjs:nodejs /app/.next

USER nextjs
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3001/ >/dev/null 2>&1 || exit 1

# Deterministic entrypoint: no npx resolution, no chance of a network lookup.
CMD ["node", "node_modules/next/dist/bin/next", "start", "--port", "3001", "--hostname", "0.0.0.0"]
