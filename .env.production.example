# =============================================================================
# Enterprise RAG Copilot — 生产 Demo 环境变量模板
# =============================================================================
# 用法（在服务器上执行，不提交 Git）：
#     cp .env.production.example .env
#     # 填入真实 LLM_API_KEY，其余保持默认即可
#     chmod 600 .env
#
# 本文件**不含任何真实密钥**，可以安全地进入版本库。
#
# 生产 Demo 部署为「公开只读演示」（2026-09-18 起）：
#     1. DEMO_PASSWORD 留空  —— 任何人可直接访问，无需密码
#     2. DEMO_READ_ONLY=true —— 公众只能读，上传/编辑/删除/重建索引全部拒绝
#     3. RATE_LIMIT_ENABLED=true —— AI 端点按 IP 限流，保护 DeepSeek 额度
#
# 若要恢复密码门禁：把 DEMO_PASSWORD 填成强随机串并重建容器即可，
# 认证代码从未删除。
# =============================================================================

# ---------------------------------------------------------------- LLM --------
# 必填：真实密钥只写在服务器 .env 里，不要提交、不要写进镜像。
LLM_API_KEY=REPLACE_WITH_REAL_KEY
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------- Embedding --------
# hashing = 离线确定性哈希向量。生产 Demo 保持 hashing：
# 不依赖任何 embedding key、不产生额外调用费用、行为完全确定。
EMBEDDING_PROVIDER=hashing
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

# ------------------------------------------------------------- 检索 ----------
# 与 V3 验收版本完全一致，不要在生产 Demo 上调参。
RETRIEVER_MODE=hybrid
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
FUSION_STRATEGY=rrf
FUSION_ALPHA=0.5
RRF_K=60
RERANK_PROVIDER=heuristic

# ------------------------------------------------------- 向量存储 ------------
# 生产 Demo 使用 numpy（进程内精确检索）。
# pgvector 代码已实现但**未经集成验证**，本次不启用，也不会启动 db 服务。
VECTOR_STORE=numpy
DATABASE_URL=

# ------------------------------------------------------------- 切分 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ------------------------------------------------------------ Agent ----------
AGENT_ENGINE=langgraph
AGENT_MAX_STEPS=12
AGENT_ALLOW_GENERAL_FALLBACK=true
AGENT_REQUIRE_HUMAN_CHECK=false

# ------------------------------------------------------------ Prompt ---------
PROMPT_VERSION=v1

# ------------------------------------------------ 演示访问控制（公开演示）---
# 访问密码：**留空** = 公开演示，任何人可直接进入，前端自动跳过登录页。
# 想恢复密码门禁就填一个强随机串（openssl rand -base64 24）并重建容器，
# 认证中间件与登录页都还在，不需要改代码。
DEMO_PASSWORD=
# 只读锁：关闭上传 / 编辑 / 删除 / 重建索引 / 清空台账。
# 公开演示下这一条是唯一的内容保护，**必须为 true**。
# 注意：读操作不受影响，检索与问答正常。
DEMO_READ_ONLY=true

# ---------------------------------------------------- AI 端点限流 ------------
# 公开演示没有密码，AI 端点会消耗真实 token 额度，必须限流兜底。
# 只覆盖高成本端点；浏览类端点（overview / 知识库浏览 / retrieve）不限流，
# 以免正常浏览体验被节流。
# 超限返回 HTTP 429 + {"error":{"code":"rate_limit_exceeded"}}。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# -------------------------------------------------------------- 路径 ---------
# ⚠️ 不要在这里设置 KB_DIR / PROMPTS_DIR / DATA_DIR。
# 容器内的路径由 docker-compose.yml 的 environment 显式钉住
# （/app/knowledge_base、/app/prompts、/app/backend/data）。
# 若在此写成空值，env_file 会覆盖镜像 ENV，导致以 0 文档启动。

# ------------------------------------------------------------ 上传限制 -------
# 只读模式下上传已被服务层拒绝（403），此值仅作为第二道防线。
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_SUFFIXES=.md,.txt,.pdf,.docx

# -------------------------------------------------------------- 可观测 -------
ACTIVITY_ENABLED=true
ACTIVITY_BACKEND=sqlite
ACTIVITY_MAX_RECORDS=2000

# ---------------------------------------------------------------- CORS -------
# 生产为同源访问（Nginx 把 /api 转到 backend），CORS 实际不生效。
# 填写域名便于排查；不要填 *。
CORS_ORIGINS=https://rag.changziqi.com

# --------------------------------------------------------------- 运行时 ------
APP_NAME=Enterprise RAG Copilot
APP_VERSION=3.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------ 端口与 API 反代 -------
# 只有 web 端口对公网开放；backend 端口绑定在 127.0.0.1，仅本机可访问。
# 8080/8000 在本服务器上已被 gunicorn（eat.changziqi.com）占用，所以默认 18000。
BACKEND_HOST_PORT=18000
WEB_HOST_PORT=3001

# web 容器把 /api 与 /health 反代到 backend 的地址。
# 运行期读取（见 apps/web/next.config.ts），改它只需重启容器，**不需要重建镜像**。
API_PROXY_TARGET=http://backend:8000

# ------------------------------------------- 前端构建参数（构建期，可留空）----
# 留空 = 同源模式：浏览器请求 `/api/...`，由 Next 反代到 backend。
# 这是生产推荐值，也是唯一的默认值 —— 它从根上杜绝了「包里残留 localhost:8000」。
#
# 只有在「前端与后端不同源」时才需要填绝对地址（一般仅本地开发使用）。
NEXT_PUBLIC_API_BASE_URL=

# ----------------------------------- 构建期镜像源（可选，仅 docker compose build 用）----
# 这两个变量**不会被注入到运行中的容器**，只在 `docker compose build` 时由
# docker-compose.yml 的 build.args 插值并传给 Dockerfile。
# 留空 = 使用上游官方源（PyPI / npmjs）。
#
# ⚠️ 实测（腾讯云大陆主机）：pypi.org 仅 ~18 KB/s、registry.npmjs.org ~146 KB/s，
# 而腾讯云镜像分别 ~4.4 MB/s / ~49 MB/s。backend 依赖 74 个包、web 需要整棵
# node_modules，走上游会把这个构建拖成数小时甚至卡死。若你的构建机到上游也很慢，
# 取消下面两行注释并指向可用的区域镜像（务必以 / 结尾、且不带协议外路径）：
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple/
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
PIP_INDEX_URL=
NPM_REGISTRY=
