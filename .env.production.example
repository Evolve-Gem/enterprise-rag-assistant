# =============================================================================
# Enterprise RAG Copilot — 生产 Demo 环境变量模板
# =============================================================================
# 用法（在服务器上执行，不提交 Git）：
#     cp .env.production.example .env
#     # 填入真实 LLM_API_KEY 与 DEMO_PASSWORD，其余保持默认即可
#     chmod 600 .env
#
# 本文件**不含任何真实密钥**，可以安全地进入版本库。
#
# ⚠️ 生产 Demo 的两条硬性安全要求：
#     1. DEMO_PASSWORD 必须设置 —— 否则公网任何人可读知识库
#     2. DEMO_READ_ONLY=true  —— 否则公网任何人可上传/删除文档
# 二者缺一不可；验收清单见 docs/DEPLOYMENT_REPORT.md
# =============================================================================

# ---------------------------------------------------------------- LLM --------
# 必填：真实密钥只写在服务器 .env 里，不要提交、不要写进镜像。
LLM_API_KEY=REPLACE_WITH_REAL_KEY
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------- Embedding --------
# hashing = 离线确定性哈希向量。生产 Demo 保持 hashing：
# 不依赖任何 embedding key、不产生额外调用费用、行为完全确定。
EMBEDDING_PROVIDER=hashing
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

# ------------------------------------------------------------- 检索 ----------
# 与 V3 验收版本完全一致，不要在生产 Demo 上调参。
RETRIEVER_MODE=hybrid
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
FUSION_STRATEGY=rrf
FUSION_ALPHA=0.5
RRF_K=60
RERANK_PROVIDER=heuristic

# ------------------------------------------------------- 向量存储 ------------
# 生产 Demo 使用 numpy（进程内精确检索）。
# pgvector 代码已实现但**未经集成验证**，本次不启用，也不会启动 db 服务。
VECTOR_STORE=numpy
DATABASE_URL=

# ------------------------------------------------------------- 切分 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ------------------------------------------------------------ Agent ----------
AGENT_ENGINE=langgraph
AGENT_MAX_STEPS=12
AGENT_ALLOW_GENERAL_FALLBACK=true
AGENT_REQUIRE_HUMAN_CHECK=false

# ------------------------------------------------------------ Prompt ---------
PROMPT_VERSION=v1

# ------------------------------------------------ ⚠️ 演示访问控制 ------------
# 访问密码：只用强随机串，仅在服务器 .env 中存在。
#   生成示例：openssl rand -base64 24
DEMO_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
# 只读锁：关闭上传 / 编辑 / 删除 / 重建索引 / 清空台账。
# 注意：读操作不受影响，检索与问答正常。
DEMO_READ_ONLY=true

# -------------------------------------------------------------- 路径 ---------
# ⚠️ 不要在这里设置 KB_DIR / PROMPTS_DIR / DATA_DIR。
# 容器内的路径由 docker-compose.yml 的 environment 显式钉住
# （/app/knowledge_base、/app/prompts、/app/backend/data）。
# 若在此写成空值，env_file 会覆盖镜像 ENV，导致以 0 文档启动。

# ------------------------------------------------------------ 上传限制 -------
# 只读模式下上传已被服务层拒绝（403），此值仅作为第二道防线。
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_SUFFIXES=.md,.txt,.pdf,.docx

# -------------------------------------------------------------- 可观测 -------
ACTIVITY_ENABLED=true
ACTIVITY_BACKEND=sqlite
ACTIVITY_MAX_RECORDS=2000

# ---------------------------------------------------------------- CORS -------
# 生产为同源访问（Nginx 把 /api 转到 backend），CORS 实际不生效。
# 填写域名便于排查；不要填 *。
CORS_ORIGINS=https://rag.changziqi.com

# --------------------------------------------------------------- 运行时 ------
APP_NAME=Enterprise RAG Copilot
APP_VERSION=3.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------ 端口与 API 反代 -------
# 只有 web 端口对公网开放；backend 端口绑定在 127.0.0.1，仅本机可访问。
# 8080/8000 在本服务器上已被 gunicorn（eat.changziqi.com）占用，所以默认 18000。
BACKEND_HOST_PORT=18000
WEB_HOST_PORT=3001

# web 容器把 /api 与 /health 反代到 backend 的地址。
# 运行期读取（见 apps/web/next.config.ts），改它只需重启容器，**不需要重建镜像**。
API_PROXY_TARGET=http://backend:8000

# ------------------------------------------- 前端构建参数（构建期，可留空）----
# 留空 = 同源模式：浏览器请求 `/api/...`，由 Next 反代到 backend。
# 这是生产推荐值，也是唯一的默认值 —— 它从根上杜绝了「包里残留 localhost:8000」。
#
# 只有在「前端与后端不同源」时才需要填绝对地址（一般仅本地开发使用）。
NEXT_PUBLIC_API_BASE_URL=
