# Local development environment for the web app.
#
# Same-origin mode (matches production): leave NEXT_PUBLIC_API_BASE_URL empty so
# the browser calls `/api/...` on the Next origin and Next proxies it to the
# backend. This is what production uses, so local and prod behave identically and
# no stale absolute URL can end up in a bundle.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8000

# Alternative: talk to the backend directly (cross-origin). Useful when the
# backend runs on another host. Remember to allow this origin in CORS_ORIGINS.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
